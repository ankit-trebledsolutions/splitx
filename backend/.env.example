# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/splity

# Image storage (Cloudinary dashboard -> API Keys). Leave all three empty to
# store uploads in ./uploads instead (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (https://resend.com -> API Keys). Leave the key empty to print emails
# to the console instead of sending them (development only).
RESEND_API_KEY=
EMAIL_FROM=Splix <noreply@yourdomain.com>

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
STREAM_API_KEY=
STREAM_API_SECRET=

# OAuth
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# AI itinerary planning (https://platform.openai.com -> API keys). Use a
# project-scoped key with a monthly spend limit. Leave the key empty and the
# planner answers "not configured"; everything else keeps working.
OPENAI_API_KEY=
# Model that writes the plan.
OPENAI_MODEL=gpt-5.6-luna
# Tried once if OpenAI says the model above does not exist for this key.
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
# Milliseconds one attempt may take before it is abandoned.
OPENAI_TIMEOUT_MS=90000
# Tests and local fakes only (scripts/fake-openai.js). Ignored in production.
OPENAI_BASE_URL=
# Paid runs one person may start per 24 hours.
AI_ITINERARY_USER_DAILY_CAP=5
# Paid runs one group may have per 24 hours.
AI_ITINERARY_GROUP_DAILY_CAP=3
# Paid runs across the whole server per 24 hours.
AI_ITINERARY_GLOBAL_DAILY_CAP=200

