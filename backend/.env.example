# Server
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/splity

# File storage: Cloudflare R2 (dashboard -> R2 Object Storage). The bucket stays
# private. The access keys come from Manage API tokens -> Create Account API
# token, with Object Read & Write on this bucket only. Leave all four empty to
# store uploads in ./uploads instead (development only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Where the app fetches stored files from; saved with every upload. Without a
# domain: this server's /media, e.g. https://srv123456.hstgr.cloud/media. Leave
# empty in development ("/media" on whatever address the app uses).
MEDIA_BASE_URL=

# Email (https://resend.com -> API Keys). Leave the key empty to print emails
# to the console instead of sending them (development only).
RESEND_API_KEY=
EMAIL_FROM=Splix <noreply@yourdomain.com>

# Admin panel > Third-Party APIs. API keys saved in the panel are encrypted
# with this before they are stored. Any long random text; make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set it once and keep it: if it changes, the keys saved under the old one can
# no longer be read and have to be entered in the panel again. Leave it empty
# and the panel shows the keys in use but cannot save new ones.
SETTINGS_ENCRYPTION_KEY=

# Reminders. The alarm rings from each phone; at reminder time the server also
# adds it to the in-app notification list and sends a backup push to anyone
# whose phone never confirmed the alarm. That timer is on by default when
# NODE_ENV=production and off otherwise. Set on/off here to override, and keep
# it off on any machine that points at the live database.
REMINDER_SWEEP=

# Links this server hands out: group invite links (https://<host>/join/<code>)
# and the public logo address. The scheme and host people should see, with no
# trailing slash. Leave empty to use whatever address each request came in on.
PUBLIC_URL=
# Android App Links: the SHA-256 fingerprint(s) of the keystore the APK is
# signed with, comma-separated, so an invite link opens the app directly:
#   keytool -list -v -keystore <keystore> | grep SHA256
# Unset, assetlinks.json lists the stock debug keystore in
# mobile/android/app/debug.keystore, which local Gradle builds sign with.
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=com.splity.app

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
STREAM_API_KEY=
STREAM_API_SECRET=

# OAuth
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# AI itinerary planning (https://platform.openai.com -> API keys). Use a
# project-scoped key with a monthly spend limit. Leave the key empty and the
# planner answers "not configured"; everything else keeps working.
OPENAI_API_KEY=
# Model that writes the plan.
OPENAI_MODEL=gpt-5.6-luna
# Tried once if OpenAI says the model above does not exist for this key.
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
# Milliseconds one attempt may take before it is abandoned.
OPENAI_TIMEOUT_MS=90000
# Tests and local fakes only (scripts/fake-openai.js). Ignored in production.
OPENAI_BASE_URL=
# Paid runs one person may start per 24 hours.
AI_ITINERARY_USER_DAILY_CAP=5
# Paid runs one group may have per 24 hours.
AI_ITINERARY_GROUP_DAILY_CAP=3
# Paid runs across the whole server per 24 hours.
AI_ITINERARY_GLOBAL_DAILY_CAP=200

# Face Scan in the gallery. The face service (face-service/ at the project
# root) runs as a container next to the API; docker-compose.yml sets this to
# http://face:8000. Leave it empty and Face Scan answers "not available", no
# photo is ever scanned, and everything else keeps working. For a local run
# without Python: node scripts/fake-face.js, then http://127.0.0.1:4020.
FACE_SERVICE_URL=
# Milliseconds one photo may take at the face service.
FACE_SERVICE_TIMEOUT_MS=30000
# Two faces are the same person at or above this similarity (0..1). Lower
# finds more photos and more wrong ones. The same person scores about 0.7 on
# clean portraits, different people under 0.3.
FACE_MATCH_THRESHOLD=0.4
# The detector's working size for uploaded photos and for the scanned picture.
# Bigger finds smaller faces and is slower.
FACE_INDEX_DET_SIZE=960
FACE_QUERY_DET_SIZE=640
# off: this process answers scans but scans no uploads (for a second API
# process, or a machine pointed at a shared database).
FACE_SCAN_WORKER=on

# Stay and attraction suggestions (https://myprojects.geoapify.com -> project
# -> API key). The free plan needs no card. Leave empty and the app shows no
# suggestions; everything else keeps working.
GEOAPIFY_API_KEY=
# Milliseconds one Geoapify request may take.
GEOAPIFY_TIMEOUT_MS=8000
# Tests and the local fake only (scripts/fake-geoapify.js). Ignored in production.
GEOAPIFY_BASE_URL=
# Hours one destination's suggestions are kept before Geoapify is asked again.
PLACES_CACHE_HOURS=24
# Fresh lookups (cache misses) one person may cause per 24 hours.
PLACES_USER_DAILY_CAP=30
# Fresh lookups across the whole server per 24 hours.
PLACES_GLOBAL_DAILY_CAP=400
# The name search on the Stays and Attractions tabs: new names one person may
# look up per 24 hours, and across the whole server. Each is one Geoapify call.
PLACES_SEARCH_USER_DAILY_CAP=150
PLACES_SEARCH_GLOBAL_DAILY_CAP=2000

