# Rendered at container start: ${API_DOMAIN} and ${ADMIN_DOMAIN} come from the
# project's .env (see docker-compose.yml). Nginx's own $variables are left alone,
# because the image only substitutes variables that are set in the environment.

# Docker's internal DNS, asked again every 10s so a recreated api container
# (new IP) is found without restarting Nginx.
resolver 127.0.0.11 valid=10s;

server {
  listen 80;
  server_name ${API_DOMAIN} ${ADMIN_DOMAIN};
  return 301 https://$host$request_uri;
}

# API and socket.io (chat, calls)
server {
  listen 443 ssl;
  http2 on;
  server_name ${API_DOMAIN};

  ssl_certificate     /etc/nginx/certs/origin.pem;
  ssl_certificate_key /etc/nginx/certs/origin.key;

  # Uploads are capped by the API (middleware/upload.js): 10 MB for photos and
  # chat files, 90 MB for gallery videos. A little more is let through here so
  # the API's limit is the one hit, and answers with a message the app shows.
  client_max_body_size 95m;

  location / {
    set $api http://api:4000;
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
  }
}

# Admin panel
server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};

  ssl_certificate     /etc/nginx/certs/origin.pem;
  ssl_certificate_key /etc/nginx/certs/origin.key;
  client_max_body_size 12m;

  root /usr/share/nginx/html;

  # The panel calls /api on its own origin so its session cookie stays
  # same-site (admin/src/lib/api.js); pass those on to the API, along with
  # the stored files it shows (/media).
  location ~ ^/(api|uploads|media)/ {
    set $api http://api:4000;
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    try_files $uri /index.html;
  }
}
