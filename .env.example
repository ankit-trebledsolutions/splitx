# Read by docker-compose.yml on the server. Copy to .env and fill in.

# With a real domain: both names point at the VPS in Cloudflare DNS (proxied),
# and the Cloudflare origin certificate goes in deploy/certs.
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com

# Without a domain (testing): put the VPS's Hostinger name (hPanel > VPS >
# Overview, e.g. srv123456.hstgr.cloud) in BOTH lines above, and uncomment the
# line below. API and admin panel then share that one name, with a Let's
# Encrypt certificate. Delete this line again once a real domain is set up.
# COMPOSE_FILE=docker-compose.yml:docker-compose.no-domain.yml
