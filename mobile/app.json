{
  "expo": {
    "name": "Splix",
    "slug": "splity",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#060D11"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.splity.app"
    },
    "android": {
      "package": "com.splity.app",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "dcc7c129-b738-468c-b681-f4b90e08c1a1"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24
          }
        }
      ],
      "@stream-io/video-react-native-sdk",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Splix needs camera access for group video calls",
          "microphonePermission": "Splix needs microphone access for group calls"
        }
      ]
    ]
  }
}
