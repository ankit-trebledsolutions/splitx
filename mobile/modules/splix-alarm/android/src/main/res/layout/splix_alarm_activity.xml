<?xml version="1.0" encoding="utf-8"?>
<!-- The alarm screen. Colours and shapes follow the app's dark theme
     (mobile/src/theme/index.js); change them in res/drawable and here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/splix_alarm_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/splix_alarm_bg"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:paddingLeft="24dp"
  android:paddingTop="24dp"
  android:paddingRight="24dp"
  android:paddingBottom="24dp">

  <TextView
    android:id="@+id/splix_alarm_label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:letterSpacing="0.18"
    android:text="REMINDER"
    android:textColor="#8A97A6"
    android:textSize="12sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/splix_alarm_group"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/splix_alarm_chip"
    android:ellipsize="end"
    android:maxLines="1"
    android:paddingLeft="12dp"
    android:paddingTop="5dp"
    android:paddingRight="12dp"
    android:paddingBottom="5dp"
    android:textColor="#F4F7FA"
    android:textSize="12sp"
    android:textStyle="bold"
    android:visibility="gone" />

  <Space
    android:layout_width="1dp"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <!-- Room for the rings to grow: they pulse from 0.6 to 1.2 of their size. -->
  <FrameLayout
    android:layout_width="248dp"
    android:layout_height="248dp">

    <View
      android:id="@+id/splix_alarm_ring_outer"
      android:layout_width="200dp"
      android:layout_height="200dp"
      android:layout_gravity="center"
      android:background="@drawable/splix_alarm_ring" />

    <View
      android:id="@+id/splix_alarm_ring_inner"
      android:layout_width="200dp"
      android:layout_height="200dp"
      android:layout_gravity="center"
      android:background="@drawable/splix_alarm_ring" />

    <FrameLayout
      android:layout_width="112dp"
      android:layout_height="112dp"
      android:layout_gravity="center"
      android:background="@drawable/splix_alarm_core">

      <ImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/splix_ic_alarm"
        android:tint="#04121C" />
    </FrameLayout>
  </FrameLayout>

  <TextView
    android:id="@+id/splix_alarm_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:textColor="#F4F7FA"
    android:textSize="52sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/splix_alarm_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="3"
    android:textColor="#F4F7FA"
    android:textSize="22sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/splix_alarm_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:gravity="center"
    android:lineSpacingExtra="3dp"
    android:maxLines="3"
    android:textColor="#8A97A6"
    android:textSize="14sp"
    android:visibility="gone" />

  <Space
    android:layout_width="1dp"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <TextView
    android:id="@+id/splix_alarm_dismiss"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/splix_alarm_button_primary"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:text="Dismiss"
    android:textColor="#04121C"
    android:textSize="16sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/splix_alarm_snooze"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/splix_alarm_button_secondary"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center"
    android:text="Snooze"
    android:textColor="#F4F7FA"
    android:textSize="16sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/splix_alarm_open"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp"
    android:text="Open in Splix"
    android:textColor="#00C4D0"
    android:textSize="14sp"
    android:textStyle="bold" />
</LinearLayout>
